# Gnani AI voice APIs. Keep the real value only in your private .env file.
GNANI_API_KEY=replace_with_your_gnani_api_key

# Agmarknet API is tried first; the official CSV is used when the API is unavailable.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Optional Agmarknet CSV path (CSV fallback)
NAMMAVAANI_MANDI_CSV=data/mandi_prices.csv
NAMMAVAANI_DB_PATH=data/namma_vani.db
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_VOICE_KN=Kavin
GNANI_TTS_VOICE_TE=Suhana
GNANI_TTS_VOICE_EN=Pranav

# Speech model selection. Default stays on the competition Prisma v2.5.
# Set prisma-v3.0 only if your Gnani account has access; this enables Auto Detect.
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_VOICE_BN=Kirra
GNANI_TTS_VOICE_GU=Falak
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_ML=Reshma
GNANI_TTS_VOICE_MR=Zahira
GNANI_TTS_VOICE_PA=Mehuli
GNANI_TTS_VOICE_TA=Asmita

# Optional multilingual response bridge for Tamil/Hindi/Malayalam/Marathi/
# Bengali/Gujarati/Punjabi. Point this to an OpenAI-compatible chat endpoint,
# for example a self-hosted multilingual Evon v3.3 deployment.
# Leave blank to keep these seven languages clearly marked as speech-beta.
NAMMAVAANI_TRANSLATION_API_URL=
NAMMAVAANI_TRANSLATION_API_KEY=
NAMMAVAANI_TRANSLATION_MODEL=
